# Database (Microsoft SQL Server)
# Option A - SQL authentication:
# DATABASE_URL="sqlserver://sa:YourStrong!Passw0rd@localhost:1433;database=mediguard;encrypt=true;trustServerCertificate=true"
# Option B - integrated security (Windows auth):
# DATABASE_URL="sqlserver://localhost:1433;database=mediguard;integratedSecurity=true;encrypt=true;trustServerCertificate=true"
DATABASE_URL="sqlserver://sa:YourStrong!Passw0rd@localhost:1433;database=mediguard;encrypt=true;trustServerCertificate=true"

# Redis (BullMQ / Redis Cloud)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_USERNAME="default"
REDIS_PASSWORD=""

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Google Gemini Vision
GEMINI_API_KEY=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""

# Firebase Cloud Messaging
FCM_SERVICE_ACCOUNT_JSON=""

# Demo mode (mock OCR, shortened escalation)
DEMO_MODE="false"

# App
PORT="3000"
NODE_ENV="development"